# ============================================================
# reels-studio — انسخ الملف ده لـ .env واملا المفاتيح
#   cp .env.example .env
# ============================================================

# --- Google Gemini API (توليد الفيديو بـ Veo) ---
# مهم: ده *مش* اشتراك Flow. لازم مفتاح من https://aistudio.google.com/apikey
# مع تفعيل الفوترة (billing) — مفيش tier مجاني لـ Veo في الـ API.
# رصيد Flow لا يتحوّل لرصيد API والعكس.
GEMINI_API_KEY=

# --- Anthropic (تقسيم السكريبت لمشاهد + كتابة برومبتات Veo) ---
ANTHROPIC_API_KEY=

# ============================================================
# إعدادات الجودة والتكلفة
# ============================================================

# fast  = veo-3.1-fast-generate-001  (~$0.10/ث @720p)  <- للتجارب
# std   = veo-3.1-generate-001       (~$0.40/ث @1080p+audio) <- للنسخة النهائية
REELS_TIER=fast

# 720p أو 1080p
REELS_RESOLUTION=720p

# ── بنية الريل ──────────────────────────────────────────────
# الجزء المتحرك المولّد بـ AI — ده اللي بيتدفع فيه فلوس.
# المخطط بيقسّمه على كليبات من [4,6,8] بأقل هدر:
#   10ث -> [4,6] = 10ث مدفوعة   |   15ث -> [8,8] = 16ث مدفوعة
REELS_VIDEO_SECONDS=10

# خاتمة: كارت ثابت باللوجو، بتتعمل بـ ffmpeg محلياً — تكلفتها صفر
REELS_OUTRO_SECONDS=5
REELS_OUTRO_LOGO=logo.png
REELS_OUTRO_BG=#1a1a2e
REELS_OUTRO_TEXT=
# زووم بطيء جداً على اللوجو بدل السكون التام (0 = ثابت خالص)
REELS_OUTRO_ZOOM=0.04

# سقف التكلفة للريل الواحد بالدولار — بيتحقق قبل أي صرف وبعد كل مشهد
REELS_MAX_COST_USD=3.00

# veo    = Veo يولّد الصوت والحوار بنفسه (أسرع، جودة العربي متفاوتة)
# silent = فيديو صامت + تصدير نص التعليق الصوتي و SRT عشان تركّب voice-over بعدين
REELS_AUDIO_MODE=veo

# حرق السَبتايتل العربي جوه الفيديو (1 = نعم)
REELS_BURN_SUBTITLES=1

# خط عربي للسبتايتل — لازم يكون موجود على الجهاز/السيرفر
# CentOS: yum install -y google-noto-sans-arabic-fonts
REELS_SUBTITLE_FONT=Noto Sans Arabic

# موسيقى خلفية اختيارية (اسم ملف جوه assets/ أو مسار مطلق).
# بتتكرر تلقائياً لو أقصر من الريل، وبتستمر على الخاتمة عشان الصوت ما ينقطعش.
REELS_MUSIC=

# مستوى الموسيقى (0.0 - 1.0)
REELS_MUSIC_VOLUME=0.12

# فيد آوت للصوت في آخر كام ثانية
REELS_AUDIO_FADEOUT=1.5
