// ─── Muslim Leader Support System ─────────────────────────────────────────────

// Auto-increment counter for sequential sponsored copy codes (ML-SP-000001)
model SponsoredCopySeq {
  id Int @id @default(autoincrement())
}

// Customer request for price support
model SupportRequest {
  id           String  @id @default(cuid())
  userId       String
  user         User    @relation("UserSupportRequests", fields: [userId], references: [id])
  productId    String
  product      Product @relation("ProductSupportRequests", fields: [productId], references: [id])
  variantIndex Int?
  quantity     Int     @default(1)

  // Reason: student | multiple_children | temp_financial | price_barrier | other
  reason String
  note   String? @db.Text

  // Price snapshot at request time (never changes)
  snapshotProductPrice  Float
  snapshotDiscount      Float  @default(0)
  snapshotEligiblePrice Float
  snapshotShipping      Float  @default(0)
  currency              String @default("EGP")

  // Customer snapshot
  customerName  String
  customerPhone String?
  customerEmail String
  country       String  @default("EG")

  // Status: PENDING | UNDER_REVIEW | APPROVED | REJECTED |
  //         MATCHED_WITH_SPONSORED_COPY | READY_FOR_CHECKOUT | USED | EXPIRED | CANCELLED
  status String @default("PENDING")

  // Admin decision: ML_SUPPORT | SPONSORED_COPY
  supportType String?

  // If ML_SUPPORT approved
  mlSupportAmount   Float?
  mlSupportPercent  Float?
  customerPayAmount Float?

  approvedAt       DateTime?
  expiresAt        DateTime?
  usedAt           DateTime?
  rejectedAt       DateTime?
  rejectionReason  String?
  reviewedByUserId String?

  mlAllocation MuslimLeaderSupportAllocation?
  assignedCopy SponsoredCopy?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([productId])
  @@index([status])
  @@index([createdAt])
}

// ML budget allocation for one approved support request
model MuslimLeaderSupportAllocation {
  id               String         @id @default(cuid())
  supportRequestId String         @unique
  supportRequest   SupportRequest @relation(fields: [supportRequestId], references: [id])

  originalPrice     Float
  supportAmount     Float
  customerPayAmount Float
  currency          String @default("EGP")

  // RESERVED | CONSUMED | RELEASED | EXPIRED
  status  String  @default("RESERVED")
  orderId String? @unique

  approvedByUserId String
  reservedAt       DateTime  @default(now())
  consumedAt       DateTime?
  releasedAt       DateTime?

  ledgerEntries MuslimLeaderSupportLedger[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// Internal ledger of ML support budget movements
model MuslimLeaderSupportLedger {
  id           String                         @id @default(cuid())
  // ML_SUPPORT_RESERVED | ML_SUPPORT_CONSUMED | ML_SUPPORT_RELEASED | ML_SUPPORT_ADJUSTMENT
  type         String
  amount       Float
  allocationId String?
  allocation   MuslimLeaderSupportAllocation? @relation(fields: [allocationId], references: [id])
  description  String?
  actorUserId  String?
  createdAt    DateTime                       @default(now())

  @@index([allocationId])
  @@index([type, createdAt])
}

// Sponsor/donor profile
model Sponsor {
  id              String   @id @default(cuid())
  userId          String?  @unique
  user            User?    @relation("UserSponsorProfile", fields: [userId], references: [id])
  name            String
  phone           String?
  email           String?
  organization    String?
  notes           String?  @db.Text
  isActive        Boolean  @default(true)
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sponsoredOrders SponsoredOrder[]
  copies          SponsoredCopy[]

  @@index([email])
  @@index([isActive])
}

// One purchase event that creates N sponsored copies
model SponsoredOrder {
  id        String  @id @default(cuid())
  sponsorId String
  sponsor   Sponsor @relation(fields: [sponsorId], references: [id])

  productId    String
  product      Product @relation("ProductSponsoredOrders", fields: [productId], references: [id])
  variantIndex Int?
  quantity     Int     @default(1)

  pricePerCopy Float
  totalPaid    Float
  currency     String @default("EGP")

  // Donor's local currency (non-EGP donors — SAR, USD, etc.)
  localCurrency     String?
  localPricePerCopy Float?
  localTotalPaid    Float?

  // paypal | bank | admin-entry
  paymentMethod String
  // pending | paid | failed | refunded
  paymentStatus String  @default("pending")
  paypalOrderId String? @unique
  paymentRef    String?

  personalOrderId String?
  adminNote       String? @db.Text
  createdByUserId String?
  policyAgreed    Boolean @default(false)

  copies SponsoredCopy[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sponsorId])
  @@index([productId])
  @@index([paymentStatus])
}

// Individual sponsored copy — unique, fully trackable unit
model SponsoredCopy {
  id   String @id @default(cuid())
  code String @unique // ML-SP-000001

  sponsorId String
  sponsor   Sponsor @relation(fields: [sponsorId], references: [id])

  sponsoredOrderId String
  sponsoredOrder   SponsoredOrder @relation(fields: [sponsoredOrderId], references: [id])

  productId    String
  product      Product @relation("ProductSponsoredCopies", fields: [productId], references: [id])
  variantIndex Int?

  originalPrice Float
  paidPrice     Float
  currency      String @default("EGP")

  // AVAILABLE | RESERVED | ASSIGNED | IN_PREPARATION | READY_TO_SHIP |
  // SHIPPED | DELIVERED | CONFIRMED | COMPLETED | CANCELLED | REFUNDED
  status String @default("AVAILABLE")

  beneficiaryUserId  String?
  beneficiaryUser    User?           @relation("BeneficiaryCopies", fields: [beneficiaryUserId], references: [id])
  supportRequestId   String?         @unique
  supportRequest     SupportRequest? @relation(fields: [supportRequestId], references: [id])
  beneficiaryOrderId String?         @unique

  shippingProvider String?
  shipmentId       String?
  trackingNumber   String?

  purchasedAt            DateTime  @default(now())
  reservedAt             DateTime?
  assignedAt             DateTime?
  preparationStartedAt   DateTime?
  shippedAt              DateTime?
  deliveredAt            DateTime?
  beneficiaryConfirmedAt DateTime?
  completedAt            DateTime?
  refundedAt             DateTime?

  refundAmount     Float?
  refundReason     String? @db.Text
  refundedByUserId String?
  refundPaymentRef String?

  events         SponsoredCopyEvent[]
  impactMessages BeneficiaryImpactMessage[]
  impactMedia    BeneficiaryImpactMedia[]
  consents       SupportConsent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sponsorId])
  @@index([productId])
  @@index([status])
  @@index([beneficiaryUserId])
}

// Append-only lifecycle event log for each sponsored copy
model SponsoredCopyEvent {
  id          String        @id @default(cuid())
  copyId      String
  copy        SponsoredCopy @relation(fields: [copyId], references: [id], onDelete: Cascade)
  event       String
  metadata    Json?
  actorUserId String?
  createdAt   DateTime      @default(now())

  @@index([copyId, createdAt])
}

// Optional thank-you message from beneficiary → reviewed before sponsor sees it
model BeneficiaryImpactMessage {
  id                String        @id @default(cuid())
  copyId            String
  copy              SponsoredCopy @relation(fields: [copyId], references: [id], onDelete: Cascade)
  beneficiaryUserId String
  message           String        @db.Text
  // PENDING_REVIEW | APPROVED | REJECTED
  status            String        @default("PENDING_REVIEW")
  reviewedByUserId  String?
  reviewedAt        DateTime?
  createdAt         DateTime      @default(now())

  @@index([copyId])
  @@index([status])
}

// Optional delivery photo from beneficiary
model BeneficiaryImpactMedia {
  id                String        @id @default(cuid())
  copyId            String
  copy              SponsoredCopy @relation(fields: [copyId], references: [id], onDelete: Cascade)
  beneficiaryUserId String
  mediaUrl          String        @db.Text
  mediaType         String        @default("photo")
  // PENDING_REVIEW | APPROVED | REJECTED
  status            String        @default("PENDING_REVIEW")
  reviewedByUserId  String?
  reviewedAt        DateTime?
  createdAt         DateTime      @default(now())

  @@index([copyId])
  @@index([status])
}

// Explicit per-field consent for identity sharing with sponsor
model SupportConsent {
  id          String        @id @default(cuid())
  copyId      String
  copy        SponsoredCopy @relation(fields: [copyId], references: [id], onDelete: Cascade)
  userId      String
  // share_first_name | share_age | share_governorate | share_message |
  // share_product_photo | share_person_photo | guardian_consent
  consentType String
  granted     Boolean       @default(false)
  grantedAt   DateTime?
  createdAt   DateTime      @default(now())

  @@unique([copyId, userId, consentType])
  @@index([copyId])
}

// ─── Tareeq Admin Panel ───────────────────────────────────────────────────────

enum TareeqAdminRole {
  SUPER_ADMIN
  MODERATOR
  SUPPORT
  SECURITY
}

model TareeqAdmin {
  id               String               @id @default(cuid())
  email            String               @unique
  password         String
  name             String
  role             TareeqAdminRole      @default(MODERATOR)
  totpSecret       String?
  totpEnabled      Boolean              @default(false)
  isActive         Boolean              @default(true)
  lastLoginAt      DateTime?
  lastLoginIp      String?
  resetToken       String?              @unique
  resetTokenExpiry DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  sessions         TareeqAdminSession[]
  auditLogs        TareeqAuditLog[]
}

model TareeqAdminSession {
  id        String      @id @default(cuid())
  adminId   String
  admin     TareeqAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  token     String      @unique
  ip        String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime    @default(now())

  @@index([adminId])
  @@index([token])
  @@index([expiresAt])
}

model TareeqAuditLog {
  id         String      @id @default(cuid())
  adminId    String
  admin      TareeqAdmin @relation(fields: [adminId], references: [id])
  action     String
  targetType String?
  targetId   String?
  details    Json?
  ip         String?
  createdAt  DateTime    @default(now())

  @@index([adminId])
  @@index([createdAt])
  @@index([action])
}

enum TareeqReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

model TareeqReport {
  id              String             @id @default(cuid())
  reporterId      String
  reporter        User               @relation("TareeqReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType      String
  targetId        String
  targetPostId    String?
  targetPost      TareeqPost?        @relation("TareeqPostReports", fields: [targetPostId], references: [id], onDelete: SetNull)
  targetCommentId String?
  targetComment   TareeqComment?     @relation("TareeqCommentReports", fields: [targetCommentId], references: [id], onDelete: SetNull)
  targetUserId    String?
  targetUser      User?              @relation("TareeqUserReports", fields: [targetUserId], references: [id], onDelete: SetNull)
  reason          String
  description     String?            @db.Text
  status          TareeqReportStatus @default(PENDING)
  reviewedBy      String?
  reviewedAt      DateTime?
  resolution      String?
  createdAt       DateTime           @default(now())

  @@index([status])
  @@index([reporterId])
  @@index([targetType])
  @@index([createdAt])
}

enum TareeqBanType {
  TEMPORARY
  PERMANENT
  RESTRICTED
}

model TareeqBan {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation("TareeqBans", fields: [userId], references: [id], onDelete: Cascade)
  type      TareeqBanType
  reason    String        @db.Text
  bannedBy  String
  expiresAt DateTime?
  isActive  Boolean       @default(true)
  liftedBy  String?
  liftedAt  DateTime?
  createdAt DateTime      @default(now())

  @@index([userId])
  @@index([isActive])
}

model TareeqFeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  description String?
  enabled     Boolean  @default(true)
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TareeqPlatformSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @db.Text
  label       String
  description String?
  type        String   @default("string")
  updatedBy   String?
  updatedAt   DateTime @updatedAt
}

enum TareeqTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model TareeqSupportTicket {
  id         String             @id @default(cuid())
  userId     String
  user       User               @relation("TareeqTickets", fields: [userId], references: [id], onDelete: Cascade)
  subject    String
  body       String             @db.Text
  status     TareeqTicketStatus @default(OPEN)
  assignedTo String?
  resolution String?            @db.Text
  notes      String?            @db.Text
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([status])
  @@index([userId])
}

model TareeqNote {
  id        String   @id @default(cuid())
  userId    String
  title     String?  @db.Text
  content   String   @db.Text
  imageUrl  String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation("TareeqNotes", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt(sort: Desc)])
  @@fulltext([title, content])
}

// ── Group Khatma ───────────────────────────────────────────────────────────

model KhatmaGroup {
  id          String              @id @default(cuid())
  name        String              @db.VarChar(100)
  description String?             @db.Text
  adminId     String
  admin       User                @relation("KhatmaGroupAdmin", fields: [adminId], references: [id])
  dailyGoal   Int                 @default(4)
  inviteCode  String              @unique @default(cuid())
  isActive    Boolean             @default(true)
  members     KhatmaGroupMember[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([adminId])
}

model KhatmaGroupMember {
  id           String      @id @default(cuid())
  groupId      String
  group        KhatmaGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId       String
  user         User        @relation("KhatmaGroupMemberships", fields: [userId], references: [id])
  streak       Int         @default(0)
  lastReadDate String?
  totalPages   Int         @default(0)
  points       Int         @default(0)
  currentPage  Int         @default(1)
  currentSurah Int         @default(1)
  currentAyah  Int         @default(1)
  joinedAt     DateTime    @default(now())

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}
