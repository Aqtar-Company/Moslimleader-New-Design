  callerIce Json? // ICE candidate array from caller
  calleeIce Json? // ICE candidate array from callee
  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime  @default(now())

  caller User @relation("TareeqCallCaller", fields: [callerId], references: [id], onDelete: Cascade)
