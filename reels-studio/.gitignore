# المفاتيح
.env

node_modules/

# المخرجات — فيديوهات كبيرة، مالهاش لازمة في git
out/
queue/*.json
!queue/.gitkeep

# الصور المرجعية للشخصيات: وجوه حقيقية، ما تترفعش على الريبو
characters/*/refs/*
!characters/*/refs/.gitkeep

# الأصول الثقيلة (لوجو/موسيقى) — تتحط يدوياً على السيرفر
assets/*
!assets/.gitkeep
!assets/README.md
